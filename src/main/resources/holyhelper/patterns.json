    "exchange": {
      "screenTitle": "^\\s*(Биржа|Создание лота)",
      "rate": "Курс:\\s*([\\d\\s,\\u00A0]+)",
      "expected": "Ожидается:\\s*([\\d\\s,\\u00A0]+)",
      "available": "Доступно:\\s*([\\d\\s,\\u00A0]+)",
      "willGet": "Вы получите:\\s*([\\d\\s,\\u00A0]+)",
