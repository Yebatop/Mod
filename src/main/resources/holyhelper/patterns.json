      "gems": "^\\s*Гемов:\\s*([\\d\\s,\\u00A0]+)",
      "coins": "^\\s*Монеток:\\s*([\\d\\s,\\u00A0]+)",
      "kills": "^\\s*Убийств:\\s*([\\d\\s,\\u00A0]+)",
      "deaths": "^\\s*Смертей:\\s*([\\d\\s,\\u00A0]+)",
      "ping": "^\\s*Пинг:\\s*([\\d\\s,\\u00A0]+)",
      "server": "(Прайм)\\s*#\\s*(\\d+)"
    },

    "buyer": {
      "screenTitle": "^\\s*(Торговля и заработок|Скупец)",
