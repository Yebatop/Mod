{
  "version": 4,
  "_комментарий": [
    "Регулярки разбора игровых строк Прайм Анархии. Сняты со скриншотов живого сервера.",
    "Первая группа каждой регулярки — то, что нужно вытащить.",
    "Числа очищаются от разделителей автоматически: сервер печатает разряды то запятой,",
    "то пробелом, то никак, поэтому подгонять формат под конкретный экран не нужно.",
    "Метки намеренно не привязаны к началу строки: слева от них сервер рисует полоску",
    "U+258C. Вместо якоря — проверка, что прямо перед меткой нет буквы.",
    "Свободный текст захватывается классом без §: справа строки несут невидимый хвост",
    "из § и служебного символа, и жадный (.+) утащил бы его в значение. Там, где строка",
    "закрыта якорем $, хвост разрешён явно: иначе захват упирался бы в § и не совпадал",
    "вовсе.",
    "У множителей метка и значение стоят на РАЗНЫХ строках: «Доступно:», ниже «0 стаков».",
    "Поэтому availableLabel не захватывает ничего, а число берётся из следующей строки.",
    "Периоды ротации сервер печатает сам в «Полезной информации» — читаем оттуда,",
    "а не зашиваем 6 и 8 часов в код.",
    "Если после обновления сервера что-то перестало разбираться — правьте здесь,",
    "пересобирать мод не требуется."
  ],

  "patterns": {
    "board": {
      "nick": "(?<![\\p{L}])Ник:\\s*([^\\s§]+)",
      "group": "(?<![\\p{L}])Группа:\\s*([^§]*?)\\s*(?:§.*)?$",
      "tokens": "(?<![\\p{L}])Жетонов:\\s*([\\d\\s,\\u00A0]+)",
      "gems": "(?<![\\p{L}])Гемов:\\s*([\\d\\s,\\u00A0]+)",
      "coins": "(?<![\\p{L}])Монеток:\\s*([\\d\\s,\\u00A0]+)",
      "kills": "(?<![\\p{L}])Убийств:\\s*([\\d\\s,\\u00A0]+)",
      "deaths": "(?<![\\p{L}])Смертей:\\s*([\\d\\s,\\u00A0]+)",
      "ping": "(?<![\\p{L}])Пинг:\\s*([\\d\\s,\\u00A0]+)",
      "server": "(Прайм)\\s*#\\s*(\\d+)"
    },

    "buyer": {
      "hubTitle": "^\\s*Скупец\\s*$",
      "tradeTitle": "^\\s*Торговля и заработок\\s*$",
      "multipliersTitle": "^\\s*Множители торговли\\s*$",
      "stagesTitle": "^\\s*Этапы и награды\\s*$",
      "special": "Особое предложение",
      "available": "Доступно к торговле:\\s*([\\d\\s,\\u00A0]+)",
      "batchPrice": "Начальная цена за\\s*(\\d+)\\s*шт:\\s*([\\d\\s,\\u00A0]+)",
      "finalPrice": "(?:Цена с множителями|с учётом множителей):\\s*([\\d\\s,\\u00A0]+)",
      "rotation": "Обновление товаров через:\\s*(?:(\\d+)\\s*ч\\.)?\\s*(?:(\\d+)\\s*мин\\.)?\\s*(?:(\\d+)\\s*сек)",
      "stage": "Этап\\s*#\\s*(\\d+)",
      "progress": "Прогресс:\\s*([\\d\\s,\\u00A0]+)\\s*/\\s*([\\d\\s,\\u00A0]+)",
      "back": "^\\s*[^\\p{L}]*Назад\\s*(?:§.*)?$"
    },

    "multiplier": {
      "name": "^\\s*Множитель на\\s+([^§]+?)\\s*(?:§.*)?$",
      "availableLabel": "^\\s*[^\\p{L}]*Доступно:\\s*(?:§.*)?$",
      "stacks": "(\\d+)\\s*стак",
      "level": "(\\d+)\\s*уровня"
    },

    "info": {
      "title": "^\\s*Полезная информация\\s*$",
      "regularRotation": "обычные торги обновляются раз в\\s*(\\d+)\\s*час",
      "specialRotation": "особые торги обновляются раз в\\s*(\\d+)\\s*час"
    },

    "daily": {
      "title": "^\\s*Ежедневная сделка\\s*$",
      "goal": "Заработайте у Скупца\\s*([\\d\\s,\\u00A0]+)\\s*монеток",
      "indicator": "показатель ежедневности",
      "percent": "^[^\\d%]*(\\d+)\\s*%",
      "rewardsHeader": "Случайная награда",
      "reward": "^\\s*[-\\u2013\\u2014]\\s*([^§]+?)\\s*(?:§.*)?$"
    },

    "market": {
      "screenTitle": "^\\s*Маркет\\s*\\((\\d+)\\s*/\\s*(\\d+)\\)",
      "category": "Категория:\\s*([^§]*?)\\s*(?:§.*)?$",
      "seller": "Продавец:\\s*([^\\s§]+)",
      "timeLeft": "Осталось времени:\\s*(?:(\\d+)\\s*ч\\.)?\\s*(?:(\\d+)\\s*мин\\.)?\\s*(?:(\\d+)\\s*сек)",
      "price": "(?<![\\p{L}])Цена:\\s*([\\d\\s,\\u00A0]+)",
      "unitPrice": "Цена за 1 ед\\.:\\s*([\\d\\s,\\u00A0]+)"
    },

    "exchange": {
      "screenTitle": "^\\s*(Биржа|Создание лота)\\s*$",
      "rate": "Курс:\\s*([\\d\\s,\\u00A0]+)",
      "expected": "Ожидается:\\s*([\\d\\s,\\u00A0]+)",
      "available": "Доступно:\\s*([\\d\\s,\\u00A0]+)",
      "willGet": "Вы получите:\\s*([\\d\\s,\\u00A0]+)",
      "willGive": "Вы отдадите:\\s*([\\d\\s,\\u00A0]+)",
      "offerOwner": "Заявка игрока\\s*([^\\s§]+)"
    }
  }
}
